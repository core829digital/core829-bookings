# Convex — set automatically by `npx convex dev` on first run (do not hand-edit
# CONVEX_DEPLOYMENT; it's written to .env.local by the Convex CLI after login).
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Resend — booking confirmation/reminder emails (mirrors the core829-new-final
# app/api/contact/route.ts pattern).
RESEND_API_KEY=
BOOKING_FROM_EMAIL=
BOOKING_NOTIFY_TO_EMAIL=

# Phase 3+ only — server-side pepper combined with SHA-256 when hashing API
# key secrets. Never log or expose this value.
API_KEY_HASH_PEPPER=

# Google Calendar sync (optional, per team member opt-in). Create an OAuth
# 2.0 Client ID (type "Web application") in Google Cloud Console, enable the
# Google Calendar API, and add these authorized redirect URIs:
#   http://localhost:3000/api/google/callback (dev)
#   https://bookings.core829.net/api/google/callback (prod)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID goes here (Next.js side, public by design).
# GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET also need to be set as CONVEX
# deployment env vars (`npx convex env set`), not just here — the token
# exchange happens server-side in a Convex action.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
